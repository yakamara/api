{
    "name": "yakamara/api",
    "type": "redaxo-addon",
    "description": "REST API for REDAXO 6: bearer-token secured endpoints for structure, media, users, languages and metainfo",
    "keywords": ["redaxo", "redaxo-addon", "api", "rest", "openapi"],
    "license": "MIT",
    "homepage": "https://github.com/yakamara/api",
    "authors": [
        {
            "name": "Yakamara Media GmbH & Co. KG",
            "homepage": "https://yakamara.de"
        },
        {
            "name": "Friends Of REDAXO",
            "homepage": "https://github.com/FriendsOfREDAXO"
        }
    ],

    "require": {
        "php": "^8.5",
        "redaxo/core": "^6.0@dev",
        "symfony/routing": "^8.1"
    },

    "require-dev": {
        "phpunit/phpunit": "^12.5 || ^13.1"
    },

    "autoload": {
        "psr-4": {
            "Yakamara\\Api\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "Yakamara\\Api\\Tests\\": "tests/"
        }
    },

    "extra": {
        "redaxo": {
            "addon-class": "Yakamara\\Api\\ApiAddon"
        }
    },

    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    }
}
